{
  "manifest_version": 3,
  "name": "plugg",
  "version": "1.0.0",
  "description": "Modül yapısıyla birçok yardımcı özellik içerir.",
  "minimum_chrome_version": "116",
  "permissions": ["management", "activeTab", "scripting", "tabCapture", "offscreen", "storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "optional_permissions": ["debugger", "downloads", "tabs", "tabGroups"],
  "background": { "service_worker": "background.js", "type": "module" },
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "commands": {
    "previous-tab": { "suggested_key": { "default": "Ctrl+Q", "mac": "MacCtrl+Q" }, "description": "Son kullanılan iki sekme arasında geçiş" },
    "tab-left": { "suggested_key": { "default": "Ctrl+Left", "mac": "MacCtrl+Left" }, "description": "Sekme çubuğunda sola git" },
    "tab-right": { "suggested_key": { "default": "Ctrl+Right", "mac": "MacCtrl+Right" }, "description": "Sekme çubuğunda sağa git" },
    "custom-1": { "description": "Özel kısayol 1" },
    "custom-2": { "description": "Özel kısayol 2" },
    "custom-3": { "description": "Özel kısayol 3" },
    "custom-4": { "description": "Özel kısayol 4" },
    "custom-5": { "description": "Özel kısayol 5" },
    "custom-6": { "description": "Özel kısayol 6" },
    "custom-7": { "description": "Özel kısayol 7" },
    "custom-8": { "description": "Özel kısayol 8" }
  },
  "action": {
    "default_title": "plugg",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16x.png",
      "32": "assets/icon-32x.png",
      "48": "assets/icon-48x.png",
      "64": "assets/icon-64x.png",
      "128": "assets/icon-128x.png"
    }
  },
  "icons": {
    "16": "assets/icon-16x.png",
    "32": "assets/icon-32x.png",
    "48": "assets/icon-48x.png",
    "64": "assets/icon-64x.png",
    "128": "assets/icon-128x.png"
  }
}
